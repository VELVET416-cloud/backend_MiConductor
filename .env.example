# Configuración del Servidor
PORT=3000
CLIENT_URL=http://localhost:5173
MOBILE_CLIENT_URL=http://localhost:8081

# Base de Datos MongoDB
MONGO_URI=mongodb+srv://usuario_ejemplo:password_ejemplo@cluster0.ejemplo.mongodb.net/mi_conductor?retryWrites=true&w=majority

# Autenticación JWT
JWT_SECRET=tu_clave_secreta_jwt_aqui
JWT_EXPIRES_IN=8h

# Servicio de Correo (Nodemailer)
MAIL_HOST=smtp.ejemplo.com
MAIL_PORT=587
MAIL_USER=tu_correo@ejemplo.com
MAIL_PASSWORD=tu_password_correo

# Cloudinary (Almacenamiento de Imágenes y Evidencias de Solicitudes)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Firebase Cloud Messaging (FCM)
# Opción 1: Variables individuales
FIREBASE_PROJECT_ID=tu_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@tu_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\ntu_private_key_aqui\n-----END PRIVATE KEY-----\n"

# Opción 2: Ruta relativa o absoluta a serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json


